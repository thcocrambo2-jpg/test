 "sections": [
  {
   "key": "krea_t2i",
   "label": "🎨 Krea2",
   "headline": "Type a sentence. Get a photograph.",
   "body": [
    "Describe what you want in plain English — no keyword soup, no special syntax, no list of things to avoid. What comes back is full resolution and sharp enough to print.",
    "What sets it apart is that it doesn't look generated. Skin keeps its texture instead of turning to plastic, fabric keeps its weave, and light behaves like light. Generate a batch, keep the one that works, then lock it and make ten more just like it."
   ],
   "highlights": [
    "Plain-English prompts",
    "Print-resolution output",
    "Batches while you watch",
    "Lock a look and repeat it",
    "Fast drafts, or slow and perfect"
   ],
