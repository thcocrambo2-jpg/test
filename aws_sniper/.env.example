# Copy to .env and fill in. .env is git-ignored.

# AWS access key for the sniper (IAM -> Users -> Security credentials ->
# Create access key). Stays on this PC: it is never sent to the instance.
# Leave empty to use --profile / aws configure instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# More AWS accounts (or use + Add account on the page): the same two lines
# ending in __<name>, lowercase. Any other line below can be given per
# account the same way (e.g. EMBER_LICENSE_KEY__friend); without one, the
# account uses the plain line.
# AWS_ACCESS_KEY_ID__friend=
# AWS_SECRET_ACCESS_KEY__friend=

# The .pem of the key pair you launch with (Copy SSH, Restart app, Apply .env
# and Docker logs on the page use it). Full path.
SSH_KEY_FILE=

# These go into the instance's user data (and from there into the app).
EMBER_LICENSE_KEY=your-key-here
EMBER_NODE_TAG=your-node-tag-here
HF_TOKEN=
CIVITAI_TOKEN=
