# Copy to runpod_sniper/.env (git-ignored) and fill in.
# One account:
RUNPOD_API_KEY=rpa_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Or several named accounts — each shows up in the page's account
# dropdown under the part after RUNPOD_API_KEY_ (lowercased):
# RUNPOD_API_KEY_MAIN=rpa_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RUNPOD_API_KEY_ALT=rpa_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The pod's licence key. It lives here only — never in presets.json, which
# you can share — and goes into each create request as EMBER_LICENSE_KEY.
# The page's licence key field rewrites this line.
EMBER_LICENSE_KEY=EMBER-XXXX-XXXX
