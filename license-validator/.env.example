# Copy to .env for local runs. On Vercel set these in
# Project Settings -> Environment Variables instead.

# Atlas connection string. This is the credential the whole service exists
# to keep out of the shipped binary — it must never leave the server.
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=krea2_license

# Seconds a session counts against the seat limit after its last heartbeat.
# Raise it if clients have flaky networking; lower it to free seats faster
# after an ungraceful exit.
STALE_SECONDS=180

# Cadence handed to clients in the acquire response.
HEARTBEAT_SECONDS=60

# TTL retention for session rows. Housekeeping only — correctness comes
# from STALE_SECONDS.
SESSION_TTL_SECONDS=900

# Guards /v1/admin/*. Required to publish a build: build.sh registers each
# upload through POST /v1/admin/builds, and holds this same value in
# KREA2_ADMIN_TOKEN. Without it every admin route answers 404.
ADMIN_TOKEN=

# ── Cloudflare R2 ────────────────────────────────────────────────────────
# Where the app binary is distributed from. The bucket is PRIVATE and must
# be a different bucket from the public one serving showcase images —
# public access on R2 is a per-bucket setting, so one bucket cannot be
# both.
#
# This token must be **Object Read only**, scoped to the builds bucket.
# The service is public-facing and only ever signs GETs. build.sh holds a
# separate Object Read & Write token, and that asymmetry is the point: a
# leak here cannot replace the binary customers download.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUILDS_BUCKET=krea2-builds

# ── Publishing (the Makefile reads these; the API never does) ─────────────
# The Object Read & WRITE token, for `make publish` / build.sh. It lives
# in the same file so publishing has one place to read from, under its own
# names so it can never be confused with the read-only pair above.
#
# Do NOT set these in the Vercel project: the service only ever signs GETs,
# and a write-capable key in the deployment would turn any leak into the
# ability to replace the binary every customer downloads. They belong on
# the build machine and nowhere else. Leave them empty on any machine that
# only runs the service — the Makefile names them if they are missing.
R2_WRITE_ACCESS_KEY_ID=
R2_WRITE_SECRET_ACCESS_KEY=

# Which deployment `make publish` registers a build with. build.sh builds
# https://<tag>.vercel.app from it, exactly as config.py does on a pod —
# one name, no dots or slashes, no https:// prefix.
KREA2_NODE_TAG=

# How long a download URL stays usable. Generous because the artifact is a
# few hundred megabytes and curl's retries restart the request, which
# re-checks this deadline. A transfer already running is not cut off.
BUILD_URL_TTL_SECONDS=1800

# Presigned URLs per license per hour, 0 to disable the cap. Pods that are
# merely restarting send the hash they already have and never reach it, so
# what this actually counts is distinct machines fetching the binary.
BUILD_DOWNLOADS_PER_HOUR=20

# Retention for the download log.
DOWNLOAD_TTL_SECONDS=2592000

# Optional. Where the pricing page's "Get Started" dialog sends a customer
# who wants to change plan — the admin's Telegram. Served on /v1/plans.
# Must be https: the client drops anything else rather than render it as a
# link. Unset, the dialog still opens and explains what to do, with no
# button on it.
CONTACT_URL=https://t.me/your_admin_handle

# ── Telegram bot (optional) ──────────────────────────────────────────────
# Unset, none of this exists: /tg answers 404 to everything, exactly as
# /v1/admin/* does without an ADMIN_TOKEN. Setting the first two is what
# turns the bot on.

# From BotFather. This is the bot's whole identity — anyone holding it can
# read every message sent to the bot and send messages as it. Treat it like
# the Atlas connection string: never in a commit, never in a log, never in
# a support paste.
TELEGRAM_BOT_TOKEN=

# Authenticates every incoming update. Generate with:
#
#     openssl rand -hex 32
#
# Handed to Telegram by `npm run set-webhook`, which is then sent back in
# X-Telegram-Bot-Api-Secret-Token on every update. The random path segment
# the webhook lives at is derived from this same value, so the deployment
# and whoever runs set-webhook must hold exactly the same string — a
# mismatch shows up as a 404 in `npm run set-webhook -- --show`.
TELEGRAM_WEBHOOK_SECRET=

# Telegram user ids allowed to use the bot's admin commands, comma or space
# separated. Not a secret: knowing an id grants nothing, because Telegram
# authenticates the sender. Get yours by messaging @userinfobot.
TELEGRAM_ADMIN_IDS=

# Guards POST /internal/cron/sweep, which Vercel Cron calls to retry stuck
# provisioning and delivery. Generate it the same way as the webhook
# secret.
#
# Deliberately a separate value from ADMIN_TOKEN: that one already
# authorises publishing a build, promoting a release channel and moderating
# prompts, and a cron job that retries a provisioning step needs none of
# that.
CRON_SECRET=

# How many orders one Telegram user may have open at once, before the bot
# stops issuing new invoices to them. There to stop one user filling the
# collection with invoices they never pay; an honest customer has one.
ORDER_MAX_OPEN_PER_USER=10

PORT=3000
