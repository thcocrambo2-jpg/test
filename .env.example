# Copy this file to .env and fill in the two values you were issued.
#
#     copy .env.example .env      (Windows)
#     cp .env.example .env        (Linux/macOS)
#     docker compose up
#
# .env is gitignored. Do not commit it: the key below is yours, and a seat
# is taken per machine that uses it.
#
# Note this is NOT license-validator/.env, which holds publishing
# credentials and is only used by `make release`. Different file, different
# purpose, neither goes into the image.

# The key you were issued.
EMBER_LICENSE_KEY=

# The deployment id issued with it — a single name, no dots or slashes.
EMBER_NODE_TAG=

# ── Optional ─────────────────────────────────────────────────────────────

# A published image instead of a locally built one, e.g.
# EMBER_IMAGE=ghcr.io/<owner>/ember:latest
#EMBER_IMAGE=

# Ignore the ComfyUI baked into the image and let the app install its own,
# which is what a non-Docker pod does. For debugging a bad baked tree.
#EMBER_USE_BAKED_COMFY=0

# Fetch the start script from the licence server rather than using the copy
# baked into the image, so a fix there applies without a new image.
#EMBER_START_SOURCE=api

# Only if a CivitAI download starts refusing anonymous access.
#CIVITAI_TOKEN=
