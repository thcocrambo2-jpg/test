# Python bytecode
__pycache__/
*.py[cod]

# Nuitka build output (see build.sh)
dist/
*.build/
*.dist/
*.onefile-build/
krea2app

# Local environments
.venv/
venv/

# What docker compose reads: a customer's licence key and node tag.
# .env.example is the committed template. (license-validator/.env is a
# different file with different contents and is ignored by that directory's
# own .gitignore.)
.env

# Derived files a local dry run drops into its output dir (scripts/dryrun.py
# points KREA2_BASE_DIR at .dryrun). The sample images there are committed;
# thumbnails and zips are regenerated on demand.
.dryrun/output/.thumbs/
.dryrun/output/all_outputs_*.zip

tmp
tmp2
.gradio

# Where scripts/mirror_cloudflared.py keeps the release binaries it is
# uploading. ~95 MB of someone else's build artifacts, kept between runs
# only so a re-run does not download them again.
.cloudflared-mirror/

commands.txt


prompts/
context.md
windows/